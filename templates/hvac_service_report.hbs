<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <title>{{doc_title}}</title>
    <style>
        /* ---------- Base ---------- */
        * {
            box-sizing: border-box;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, "Noto Sans", "Helvetica Neue", sans-serif;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            color: #111;
            font-size: 12px;
        }

        .page {
            padding: 16mm 12mm;
        }

        .right {
            text-align: right;
        }

        .tiny {
            font-size: 11px;
            color: #333;
            line-height: 1.35;
        }

        .small {
            font-size: 12px;
        }

        .h1 {
            font-size: 16px;
            font-weight: 800;
            letter-spacing: .2px;
            text-transform: uppercase;
        }

        /* ---------- Letterhead (box like receipt) ---------- */
        .letterhead {
            border: 2px solid #000;
        }

        .brand {
            display: flex;
            align-items: stretch;
            /* IMPORTANT: full height divider */
            justify-content: space-between;
            gap: 0;
            /* IMPORTANT: remove gap so divider is clean */
            padding: 0;
            /* IMPORTANT: divider touches top/bottom */
            min-height: 110px;
        }

        .brand .info {
            flex: 0 0 60%;
            padding: 10px 12px;
            /* moved padding here */
        }


        .brand .info .h1 {
            margin: 0 0 2px;
        }

        .brand .logo-pane {
            flex: 0 0 40%;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            /* shift logo LEFT */
            padding: 10px 12px;
            /* same vertical padding */
            border-left: 2px solid #000;
            /* full height divider */
        }

        .brand .logo-pane img {
            max-width: 85%;
            max-height: 90px;
            height: auto;
            object-fit: contain;
        }

        /* ---------- Document title (SERVICE REPORT) ---------- */
        .doc-title {
            text-align: center;
            font-weight: 800;
            text-transform: uppercase;
            margin: 10px 0 6px;
        }

        /* ---------- Main meta grid (top part of slip) ---------- */
        .meta {
            width: 100%;
            border-left: 2px solid #000;
            border-right: 2px solid #000;
            border-bottom: 2px solid #000;
            border-collapse: collapse;
            margin: 0 0 10px;
        }

        .meta td {
            border-top: 2px solid #000;
            padding: 6px 8px;
            font-size: 11px;
            vertical-align: top;
        }

        .meta .label {
            font-weight: 700;
            text-transform: uppercase;
            width: 20%;
        }

        .meta .value {
            width: 30%;
        }

        /* ---------- AMC / Warranty / Chargeable row ---------- */
        .service-mode-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            font-size: 11px;
            font-weight: 600;
        }

        .mode-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .check-label {
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .box {
            display: inline-block;
            width: 10px;
            height: 10px;
            border: 1px solid #000;
            text-align: center;
            font-size: 9px;
            line-height: 10px;
        }

        .sr-no {
            font-weight: 700;
        }

        /* ---------- Two-column layout blocks ---------- */
        .grid2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .card {
            border: 1px solid #000;
            border-radius: 0;
            padding: 8px 10px;
        }

        .card .h2 {
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            margin: 0 0 6px;
        }

        .row {
            display: grid;
            grid-template-columns: 120px 1fr;
            gap: 6px;
            margin: 2px 0;
        }

        .row>div:first-child {
            font-weight: 600;
            font-size: 11px;
        }

        .row>div:last-child {
            font-size: 11px;
            line-height: 1.3;
        }

        /* ---------- Work completed vs additional work ---------- */
        .work-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 8px;
        }

        .work-table th,
        .work-table td {
            border: 1.5px solid #000;
            padding: 6px 8px;
            font-size: 11px;
            vertical-align: top;
        }

        .work-table th {
            background: #f6f6f6;
            font-weight: 800;
            text-transform: uppercase;
            text-align: left;
        }

        .work-lines {
            min-height: 80px;
            white-space: pre-wrap;
        }

        /* ---------- Remarks & signatures ---------- */
        .remarks-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 10px;
        }

        .remarks-box {
            border: 1px solid #000;
            padding: 6px 8px;
            font-size: 11px;
            min-height: 45px;
        }

        .remarks-label {
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .sig-row {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 10px;
            margin-top: 12px;
            font-size: 11px;
            align-items: flex-end;
        }

        .sig-left {
            border-top: 1px solid #000;
            padding-top: 18px;
            text-align: left;
        }

        .sig-right {
            border-top: 1px solid #000;
            padding-top: 18px;
            text-align: right;
        }

        .sig-label {
            font-weight: 600;
        }

        /* ---------- Optional ticket & followup cards ---------- */
        .ticket-section {
            margin-top: 12px;
        }

        .ticket-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 4px;
            font-size: 11px;
        }

        .ticket-table th,
        .ticket-table td {
            border: 1px solid #000;
            padding: 4px 6px;
        }

        .ticket-table th {
            background: #f6f6f6;
            font-weight: 700;
            text-transform: uppercase;
        }

        /* ---------- Terms & footer ---------- */
        .terms-section {
            margin-top: 12px;
            font-size: 10px;
        }

        .terms-title {
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .terms-list {
            list-style-type: none;
            padding-left: 0;
            margin: 0;
        }

        .terms-list li {
            margin-bottom: 2px;
            padding-left: 12px;
            position: relative;
        }

        .terms-list li:before {
            content: "•";
            position: absolute;
            left: 3px;
            top: 0;
        }

        .footer {
            margin-top: 10px;
            text-align: center;
            font-size: 10px;
            color: #555;
            border-top: 1px solid #ddd;
            padding-top: 6px;
        }

        .section-heading {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            margin: 8px 0 4px;
        }

        /* print safety */
        .letterhead,
        .meta {
            page-break-inside: avoid;
        }
    </style>
</head>

<body>
    <div class="page">
        <!-- HEADER (same style as first template) -->
        <div class="letterhead">
            <div class="brand">
                <div class="info">
                    <div class="h1">{{our_company.name}}</div>
                    <div class="tiny">{{our_company.legal_name}}</div>
                    <div class="tiny">{{our_company.address_line}}</div>
                    <div class="tiny">{{our_company.city_state}}</div>
                    <div class="tiny">
                        Tel: {{our_company.mobile_number}}
                    </div>
                    <div class="tiny">
                        Email: {{our_company.email_id}}
                    </div>
                    <div class="tiny">
                        Website: <b>{{our_company.website}}</b>
                    </div>
                </div>
                <div class="logo-pane">
                    {{#if logo}}
                    <img src="{{logo}}" alt="Company Logo" />
                    {{/if}}
                </div>
            </div>
        </div>

        <!-- TITLE -->
        <div class="doc-title">{{doc_title}}</div>

        <!-- TOP META (exactly like physical slip) -->
        <table class="meta">
            <!-- AMC / WARRANTY / CHARGEABLE row -->
            <tr>
                <td colspan="4">
                    <div class="service-mode-row">
                        <span class="check-label">
                            <span class="box">{{#if service_mode_amc}}✔{{/if}}</span> AMC
                        </span>
                        <span class="check-label">
                            <span class="box">{{#if service_mode_general}}✔{{/if}}</span> General
                        </span>
                        <span class="check-label">
                            <span class="box">{{#if service_mode_maintenance}}✔{{/if}}</span> Maintenance
                        </span>
                        <span class="check-label">
                            <span class="box">{{#if service_mode_services}}✔{{/if}}</span> Services
                        </span>
                        <div class="sr-no">
                            {{!-- SR. NO.: <b>{{service_report_number}}</b> --}}
                            SR. NO.: <b>{{report_id}}</b>
                        </div>
                    </div>
                </td>
            </tr>

            <!-- Service date / client name -->
            <tr>
                <td class="label">Service Date</td>
                <td class="value">{{service_date}}</td>
                <td class="label">Client Name</td>
                <td class="value">{{customer.contact_person}}</td>
            </tr>

            <!-- Service type / address -->
            <tr>
                <td class="label">Service Type</td>
                <td class="value">{{upperCase service_type}}</td>
                <td class="label">Address</td>
                <td class="value">{{customer.full_address}}</td>
            </tr>

            <!-- Instructed by / model no -->
            <tr>
                <td class="label">Instructed By</td>
                <td class="value">{{equipment.instructed_by}}</td>
                <td class="label">Model No.</td>
                <td class="value">{{equipment.model_no}}</td>
            </tr>

            <!-- Serial no / type -->
            <tr>
                <td class="label">Serial No.</td>
                <td class="value">{{equipment.serial_no}}</td>
                <td class="label">Type</td>
                <td class="value">{{equipment.type}}</td>
            </tr>

            <!-- Observation & work details -->
            <tr>
                <td class="label">Observation &amp; Work Details</td>
                <td class="value" colspan="3">{{or observation "N/A"}}</td>
            </tr>
        </table>

        <!-- WORK COMPLETED / ADDITIONAL WORK -->
        <table class="work-table">
            <thead>
                <tr>
                    <th>Work Completed</th>
                    <th>Additional Works Required</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="work-lines">
                        {{or work_done "N/A"}}
                    </td>
                    <td class="work-lines">
                        {{#if additional_work_1}}{{additional_work_1}}{{/if}}
                        {{#if additional_work_2}}<br>{{additional_work_2}}{{/if}}
                        {{#unless additional_work_1}}{{#unless additional_work_2}}N/A{{/unless}}{{/unless}}
                    </td>
                </tr>
            </tbody>
        </table>

        <!-- NAMES -->
        <div class="remarks-grid" style="margin-top:8px;">
            <div class="remarks-box">
                <div class="remarks-label">Site Incharge Name</div>
                <div>{{signatures.site_incharge_name}}</div>
            </div>
            <div class="remarks-box">
                <div class="remarks-label">Engineer / Technician's Name</div>
                <div>{{signatures.technician.name}}</div>
            </div>
        </div>

        <!-- SIGNATURES & DATE -->
        <div class="sig-row">
            <div class="sig-left">
                <div class="sig-label">Customer Signature &amp; Stamp</div>
                {{#if signatures.customer.signature}}
                <img src="{{signatures.customer.signature}}" alt="Customer Signature"
                    style="max-width:150px; max-height:60px;">
                {{/if}}
            </div>
            {{!-- <div class="sig-right">
                <div class="sig-label">Date</div>
                <div style="margin-top:4px;">{{service_date}}</div>
            </div> --}}
        </div>

        <!-- Technician & company signature line -->
        <div class="sig-row" style="margin-top:8px;">
            <div class="sig-left">
                <div class="sig-label">Engineer / Technician Signature</div>
                {{#if signatures.technician.signature}}
                <div style="margin-top:6px;">
                    <img src="{{signatures.technician.signature}}" alt="Technician Signature"
                        style="max-width:150px; max-height:60px;" />
                </div>
                {{else}}
                <div style="font-size:11px;color:#555;margin-top:6px;">
                    Signature not available
                </div>
                {{/if}}
            </div>

            {{!-- <div class="sig-right">
                <div class="sig-label">
                    {{#if signatures.company.label}}
                    {{signatures.company.label}}
                    {{else}}
                    Authorized Signatory
                    {{/if}}
                </div>
                <div style="margin-top:4px;">Authorized Signatory</div>
            </div> --}}
        </div>

        <!-- TICKET INFORMATION -->
        {{#if ticket}}
        <div class="ticket-section">
            <div class="section-heading">Ticket Information</div>
            <table class="ticket-table">
                <tr>
                    <th>Complaint ID</th>
                    <th>Resolution ID</th>
                    <th>Subject</th>
                    {{!-- <th>Status</th>
                    <th>Priority</th>
                    <th>Category</th>
                    <th>Assigned To</th> --}}
                </tr>
                <tr>
                    <td>{{ticket.caller_id}}</td>
                    <td>{{service_report_number}}</td>
                    <td>{{ticket.subject}}</td>
                    {{!-- <td>{{upperCase ticket.status}}</td> --}}
                    {{!-- <td>{{upperCase ticket.priority}}</td>
                    <td>{{upperCase ticket.category}}</td>
                    <td>{{ticket.assigned_to}}</td> --}}
                </tr>
            </table>
        </div>
        {{/if}}

        <!-- FOLLOWUP -->
        {{!-- {{#if followup}}
        <div class="ticket-section">
            <div class="section-heading">Followup Information</div>
            <div class="small">
                <b>Technician Notes:</b> {{or followup.notes "No notes provided"}}<br />
                <b>Followup Date:</b> {{followup.created_at}}
            </div>
        </div>
        {{/if}} --}}

        <!-- TERMS & CONDITIONS -->
        {{!-- <div class="terms-section">
            <div class="terms-title">Terms &amp; Conditions</div>
            <ul class="terms-list">
                {{#each terms}}
                <li>{{this}}</li>
                {{/each}}
            </ul>
        </div> --}}

        <!-- FOOTER -->
        <div class="footer">
            Generated on {{current_date}} | {{our_company.name}} | HVAC Service Report
        </div>
    </div>
</body>

</html>